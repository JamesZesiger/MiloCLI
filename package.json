{
  "name": "milo-cli",
  "version": "0.1.0",
  "description": "Milo: a cat-themed front end that runs Claude Code in the background",
  "type": "module",
  "bin": {
    "milo": "dist/milo.js"
  },
  "scripts": {
    "start": "node build/bundle.mjs && node dist/milo.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p . --noEmit && node build/bundle.mjs",
    "typecheck": "tsc -p . --noEmit",
    "frame": "tsx test/frame.tsx"
  },
  "author": "CU*Answers",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
